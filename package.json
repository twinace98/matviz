{
  "name": "vscode-matviz",
  "displayName": "MatViz - Crystal Structure Viewer",
  "description": "Interactive 3D crystal structure visualization for CIF, POSCAR, XSF, XYZ, PDB, Gaussian Cube, and more",
  "version": "0.23.0",
  "license": "MIT",
  "publisher": "matviz",
  "repository": {
    "type": "git",
    "url": "https://github.com/twinace98/matviz.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "matviz.crystalViewer",
        "displayName": "Crystal Structure Viewer",
        "selector": [
          {
            "filenamePattern": "*.cif"
          },
          {
            "filenamePattern": "*.xsf"
          },
          {
            "filenamePattern": "*.axsf"
          },
          {
            "filenamePattern": "*.poscar"
          },
          {
            "filenamePattern": "*.vasp"
          },
          {
            "filenamePattern": "POSCAR"
          },
          {
            "filenamePattern": "CONTCAR"
          },
          {
            "filenamePattern": "XDATCAR"
          },
          {
            "filenamePattern": "*.xyz"
          },
          {
            "filenamePattern": "*.pdb"
          },
          {
            "filenamePattern": "*.cube"
          },
          {
            "filenamePattern": "*.cub"
          },
          {
            "filenamePattern": "CHGCAR"
          },
          {
            "filenamePattern": "AECCAR0"
          },
          {
            "filenamePattern": "AECCAR2"
          },
          {
            "filenamePattern": "PARCHG"
          },
          {
            "filenamePattern": "geometry.in"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "matviz.crystalViewer",
        "displayName": "Crystal Structure Viewer",
        "selector": [
          {
            "filenamePattern": "*.in"
          },
          {
            "filenamePattern": "*.out"
          },
          {
            "filenamePattern": "*.stdin"
          },
          {
            "filenamePattern": "*.stdout"
          },
          {
            "filenamePattern": "*.pw"
          }
        ],
        "priority": "option"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "matviz.openInViewer",
          "when": "resourceExtname =~ /^\\.(in|out|stdin|stdout|pw)$/",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "MatViz",
      "properties": {
        "matviz.defaults.style": {
          "type": "string",
          "enum": [
            "ball-and-stick",
            "space-filling",
            "stick",
            "wireframe"
          ],
          "default": "ball-and-stick",
          "description": "Default display style for newly-opened structures. Saved per-file state (localStorage) wins on return visits."
        },
        "matviz.defaults.palette": {
          "type": "string",
          "enum": [
            "dark",
            "light"
          ],
          "default": "dark",
          "description": "Default CPK palette. Independent from VSCode editor theme."
        },
        "matviz.defaults.showBonds": {
          "type": "boolean",
          "default": true,
          "description": "Show bonds by default."
        },
        "matviz.defaults.showBoundary": {
          "type": "boolean",
          "default": true,
          "description": "Show boundary atoms (periodic-image duplicates on cell faces) by default."
        },
        "matviz.defaults.cameraMode": {
          "type": "string",
          "enum": [
            "orthographic",
            "perspective"
          ],
          "default": "orthographic",
          "description": "Default projection. Orthographic is the crystallography norm; perspective helps inspect 3D polyhedral networks."
        },
        "matviz.defaults.bondCutoffPad": {
          "type": "number",
          "default": 0.3,
          "minimum": 0,
          "maximum": 2,
          "description": "Padding (Å) added to r_A + r_B for the default bond max-cutoff. Smaller values produce sparser bond detection."
        },
        "matviz.defaults.axisIndicatorSize": {
          "type": "number",
          "default": 80,
          "minimum": 40,
          "maximum": 400,
          "description": "Default axis-indicator size in pixels. Resizable in the side panel; saved per-file state wins on return visits."
        },
        "matviz.volumetric.promptAboveBytes": {
          "type": "number",
          "default": 1073741824,
          "minimum": 0,
          "description": "When a volumetric file (cube, XSF, CHGCAR) of 256 MiB or more would need more than this many bytes of grid data at full resolution, MatViz asks which resolution to load before reading it (recommended / smaller / original). The grid header is read first, so the question appears instantly. 0 = never ask (use matviz.volumetric.maxGridPoints or the 4×10⁸-point safety cap). Ignored when matviz.volumetric.maxGridPoints is set."
        },
        "matviz.volumetric.maxGridPoints": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "description": "Cap on N_x * N_y * N_z after load-time decimation. When set, applies to every volumetric load (cube, XSF, CHGCAR) regardless of file size — the parser picks the smallest integer stride that keeps the grid under this cap, applied uniformly across all three axes. null (default) leaves grids at native resolution for files that fit in memory; the byte-path raw loader still applies an internal safety cap (~4×10⁸ points) to stay below the 4 GiB ArrayBuffer ceiling. Set a small value (e.g. 1e7) for faster isosurface rendering on routine charge densities."
        }
      }
    },
    "commands": [
      {
        "command": "matviz.openInViewer",
        "title": "Open in MatViz",
        "icon": {
          "light": "media/matviz-icon-light.svg",
          "dark": "media/matviz-icon-dark.svg"
        }
      },
      {
        "command": "matviz.openWithText",
        "title": "MatViz: Open Text Editor (split pane)"
      },
      {
        "command": "matviz.resetCamera",
        "title": "MatViz: Reset Camera"
      },
      {
        "command": "matviz.toggleBonds",
        "title": "MatViz: Toggle Bonds"
      },
      {
        "command": "matviz.viewAlongDirection",
        "title": "MatViz: View Along Direction [uvw]"
      },
      {
        "command": "matviz.viewNormalToPlane",
        "title": "MatViz: View Normal to Plane (hkl)"
      },
      {
        "command": "matviz.addLatticePlane",
        "title": "MatViz: Add Lattice Plane (hkl)"
      },
      {
        "command": "matviz.clearLatticePlanes",
        "title": "MatViz: Clear Lattice Planes"
      },
      {
        "command": "matviz.screenshot",
        "title": "MatViz: Export Screenshot"
      },
      {
        "command": "matviz.exportCif",
        "title": "MatViz: Export as CIF"
      },
      {
        "command": "matviz.exportPoscar",
        "title": "MatViz: Export as POSCAR"
      },
      {
        "command": "matviz.showWulff",
        "title": "MatViz: Show Wulff Construction"
      },
      {
        "command": "matviz.clearWulff",
        "title": "MatViz: Clear Wulff Construction"
      },
      {
        "command": "matviz.addPhase",
        "title": "MatViz: Add Phase (overlay)"
      },
      {
        "command": "matviz.clearPhases",
        "title": "MatViz: Clear Overlay Phases"
      },
      {
        "command": "matviz.compareToPhase",
        "title": "MatViz: Compare to Phase (displacement arrows)"
      },
      {
        "command": "matviz.clearComparison",
        "title": "MatViz: Clear Comparison"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test:visual": "node dist/test-visual-harness.js",
    "test:visual:update": "node dist/test-visual-harness.js --update-baseline",
    "package": "vsce package",
    "install-skill": "bash scripts/install-skill.sh",
    "install-all": "npm run build && npx @vscode/vsce package --no-dependencies && code --install-extension vscode-matviz-$npm_package_version.vsix --force && npm run install-skill"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.170.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.24.0",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "three": "^0.170.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@spglib/moyo-wasm": "^0.7.9",
    "puppeteer": "^24.41.0"
  }
}
